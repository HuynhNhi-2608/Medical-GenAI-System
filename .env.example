# Sao chép file này thành .env rồi điền thông tin. KHÔNG đưa file .env lên GitHub.
# Tên máy chủ SQL Server: "." nếu cài instance mặc định, ".\SQLEXPRESS" nếu cài bản Express (phổ biến nhất).
DB_SERVER=.\SQLEXPRESS
DB_NAME=MedicalGenAIDB
# CÁCH ĐƠN GIẢN NHẤT: để trống DB_USER và DB_PASS để dùng Windows Authentication (tài khoản Windows của bạn).
# Nếu dùng tài khoản SQL riêng, điền vào đây (đừng dùng sa với mật khẩu yếu).
DB_USER=
DB_PASS=
# Bật/tắt thành phần nặng khi phát triển (1 = bật, 0 = tắt)
ENABLE_NER=1
ENABLE_GENERATOR=1
